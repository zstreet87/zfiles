#!/usr/bin/env bash
# agent-jail -- run an agent (or any command) with your credentials out of reach:
#   agent-jail pi [args...]
# The filesystem is yours except that ~/.ssh shows only the sandbox key and ssh
# config, the ssh-agent and gpg-agent sockets are gone, and token stores are
# empty. So the agent reaches servers only through ssh-sandbox's HOST-agent
# aliases, never with your real key. The command runs only after a check inside
# the jail proves every hidden path unreadable.
# Not covered: the network (still open), and secrets stored anywhere unlisted --
# add them, one path per line, to ~/.config/agent-jail/hide.
set -euo pipefail

die() { echo "agent-jail: $*" >&2; exit 1; }
(($#)) || die "usage: agent-jail COMMAND [ARGS...]"
command -v bwrap >/dev/null || die "needs bubblewrap (bwrap)"
[[ -z ${AGENT_JAIL-} ]] || die "already inside a jail"

# What the agent may see in ~/.ssh: the sandbox key and the config that names it.
KEEP=(agent_sandbox agent_sandbox.pub config config.d known_hosts)
# Credential stores to empty (globs allowed). Directories become empty tmpfs, files
# read as /dev/null.
HIDE=(
    .gnupg .aws .azure .kube .docker .netrc .git-credentials .pki
    '.config/gh*' .config/gcloud .config/hub
    .config/shell/secrets.env .local/share/keyrings .password-store
)
extra=${XDG_CONFIG_HOME:-$HOME/.config}/agent-jail/hide
if [[ -f $extra ]]; then
    while IFS= read -r p; do
        [[ $p =~ ^[[:space:]]*(#|$) ]] || HIDE+=("${p#"$HOME"/}")
    done <"$extra"
fi

args=(--dev-bind / / --new-session --die-with-parent
    --unsetenv SSH_AUTH_SOCK --unsetenv GPG_AGENT_INFO
    --unsetenv GH_TOKEN --unsetenv GITHUB_TOKEN --unsetenv GH_CONFIG_DIR
    --setenv AGENT_JAIL 1
    --tmpfs "$HOME/.ssh")
for f in "${KEEP[@]}"; do
    [[ -e $HOME/.ssh/$f ]] && args+=(--ro-bind "$HOME/.ssh/$f" "$HOME/.ssh/$f")
done
hidden=()
shopt -s nullglob
for pat in "${HIDE[@]}"; do
  for p in "$HOME"/$pat; do # unquoted: built-in entries may be globs
    [[ -e $p ]] || continue
    if [[ -d $p ]]; then args+=(--tmpfs "$p"); else args+=(--ro-bind /dev/null "$p"); fi
    hidden+=("$p")
  done
done
shopt -u nullglob
# Agent sockets: hidden even if the agent finds the path some other way than the env.
for s in "${SSH_AUTH_SOCK-}" "/run/user/$(id -u)/gnupg"; do
    [[ -n $s && -e $s && $s != "$HOME/.ssh/"* ]] || continue
    if [[ -d $s ]]; then args+=(--tmpfs "$s"); else args+=(--ro-bind /dev/null "$s"); fi
done

# The check runs inside the jail, before the command: a private key in ~/.ssh or any
# hidden file with content means the jail did not take, and nothing runs.
# shellcheck disable=SC2016 # runs in the jail's sh, with its own $HOME and "$@"
check='
for k in "$HOME"/.ssh/*; do
    case ${k##*/} in agent_sandbox|agent_sandbox.pub|config|config.d|known_hosts|"*") ;;
        *) echo "agent-jail: $k is visible" >&2; exit 97 ;; esac
done
for p in "$@"; do
    [ "$p" = -- ] && break
    if [ -d "$p" ]; then [ -z "$(ls -A "$p" 2>/dev/null)" ] || { echo "agent-jail: $p is not empty" >&2; exit 97; }
    elif [ -s "$p" ]; then echo "agent-jail: $p is readable" >&2; exit 97; fi
done
[ -z "${SSH_AUTH_SOCK-}" ] || { echo "agent-jail: SSH_AUTH_SOCK is set" >&2; exit 97; }
while [ "$1" != -- ]; do shift; done; shift
exec "$@"'
exec bwrap "${args[@]}" sh -c "$check" agent-jail "${hidden[@]}" -- "$@"
